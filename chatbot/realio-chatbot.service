[Unit]
Description=Realio Docs Chatbot API
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/realio-network-docs/chatbot
Environment="OLLAMA_URL=http://127.0.0.1:11434"
Environment="QDRANT_URL=http://127.0.0.1:6333"
Environment="QDRANT_COLLECTION=realio_docs"
Environment="CHAT_MODEL=qwen3:8b"
Environment="EMBED_MODEL=nomic-embed-text"
Environment="ALLOWED_ORIGINS=https://realio-docs.decentrio.ventures,https://docs.realio.network"
ExecStart=/root/realio-network-docs/chatbot/venv/bin/gunicorn -w 1 -b 127.0.0.1:8000 --timeout 180 app:app
Restart=always
RestartSec=5
StandardOutput=append:/var/log/realio-chatbot.log
StandardError=append:/var/log/realio-chatbot.log

[Install]
WantedBy=multi-user.target
